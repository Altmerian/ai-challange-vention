    {
      "id": "classify-update",
      "name": "Classify Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 0],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "// Compute a single _route token from the incoming Telegram update so the\n// Switch node downstream can dispatch on one string instead of two distinct\n// paths (message.text vs callback_query.data). Longer prefixes (tpp:) are\n// checked before shorter ones (tp:) to avoid mis-routing. /learn uses a\n// command-boundary regex (not startsWith) so /learning, /learn_more, etc.\n// fall through to 'unknown' rather than being treated as /learn.\nconst LEARN_CMD = /^\\/learn(?:@\\w+)?(?:\\s|$)/;\nconst items = $input.all();\nreturn items.map((item) => {\n  const m = item.json || {};\n  const text = (m.message && m.message.text) || '';\n  const data = (m.callback_query && m.callback_query.data) || '';\n  let route = 'unknown';\n  if (text === '/start') route = '/start';\n  else if (LEARN_CMD.test(text)) route = '/learn';\n  else if (text === '/quiz') route = '/quiz';\n  else if (data.startsWith('qa:')) route = 'qa:';\n  else if (data.startsWith('rs:')) route = 'rs:';\n  else if (data.startsWith('tpp:')) route = 'tpp:';\n  else if (data.startsWith('tp:')) route = 'tp:';\n  else if (data.startsWith('qstart:')) route = 'qstart:';\n  return { json: { ...m, _route: route } };\n});\n"
      }
    },
